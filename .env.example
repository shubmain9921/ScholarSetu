# Environment variables for ScholarSetu
PROJECT_NAME="ScholarSetu"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & Tokens
SECRET_KEY="scholarsetu-secret-key-super-secure-change-in-production-sihtoken"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for Docker/Production, SQLite fallback for local dev)
# DATABASE_URL="postgresql://scholarsetu:scholarsetu_pw@localhost:5432/scholarsetu_db"
DATABASE_URL="sqlite:///./scholarsetu.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"

# MinIO / S3 Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="scholarsetu-documents"
MINIO_SECURE=false

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Mock Integrations
MOCK_DIGILOCKER_ENABLED=true
MOCK_PFMS_ENABLED=true
MOCK_EDISTRICT_ENABLED=true
